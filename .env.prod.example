# =====================================================================
# prod 环境变量模板（在服务器上复制为 .env.prod 后填写）
#   cp .env.prod.example .env.prod
# =====================================================================

# ---------- 端口（默认值，与本地开发一致）----------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MEILI_HOST_PORT=7700

# ---------- 阿里云 ACR ----------
# 格式：registry.cn-<region>.aliyuncs.com/<namespace>
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com/your-namespace

# ---------- 数据库 / 中间件 ----------
POSTGRES_USER=devshare
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=devshare
MEILI_MASTER_KEY=change-me-meili-master-key

# ---------- 鉴权 ----------
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

# ---------- 站点（需与 GitHub 变量 NUXT_PUBLIC_SITE_URL_PROD 保持一致）----------
CORS_ORIGINS=https://www.example.com
NUXT_PUBLIC_SITE_URL=https://www.example.com

# ---------- 阿里云 OSS（必需，图片与视频都由浏览器直传这里 + CDN）----------
# bucket 需允许站点域名的 CORS（GET/PUT/POST/DELETE/HEAD，暴露 ETag），对象保持公共读；
# 浏览器用 SDK 直传，文件体不经过 Node 与 nginx；图片另需开通「图片处理」才能显示为 WebP
# OSS_PUBLIC_URL 填 CDN 加速域名（回源 bucket），库里存的就是它拼对象名得到的地址
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_URL=https://cdn.devshare.bond

# ---------- 图片（可选）----------
# 单个图片最大体积（MB），默认 20；原图直传，展示时由 OSS 图片处理按需转 WebP
MAX_IMAGE_SIZE_MB=20
# 读取图片时是否让 OSS 图片处理（IMG）转 WebP：默认 on；bucket 未开通图片处理时设 off 回退原图
NUXT_PUBLIC_OSS_IMAGE_WEBP=on

# ---------- 课程视频（可选）----------
# 单个视频最大体积（MB），默认 4096（4GB）；视频直传 OSS，不受 nginx client_max_body_size 限制
MAX_VIDEO_SIZE_MB=4096
# STS 直传凭证用的角色 ARN（形如 acs:ram::1234567890:role/devshare-video）：
# 在 RAM 里建一个「可信实体为本账号 RAM 用户」的角色，并给它 OSS 读写权限；留空则图片与视频上传都不可用
OSS_STS_ROLE_ARN=
# STS 临时凭证有效期（秒）：默认 3600，下限 900，上限受角色的 MaxSessionDuration 约束
OSS_STS_DURATION_SECONDS=3600
