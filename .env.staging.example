# =====================================================================
# staging 环境变量模板（在服务器上复制为 .env.staging 后填写）
#   cp .env.staging.example .env.staging
# 端口与 prod 错开，避免同一台 ECS 上两套栈冲突。
# =====================================================================

# ---------- 端口（staging 与 prod 错开）----------
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MEILI_HOST_PORT=17700

# ---------- 阿里云 ACR ----------
# 格式：registry.cn-<region>.aliyuncs.com/<namespace>
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com/your-namespace

# ---------- 数据库 / 中间件 ----------
POSTGRES_USER=devshare_staging
POSTGRES_PASSWORD=change-me-staging-password
POSTGRES_DB=devshare_staging
MEILI_MASTER_KEY=change-me-staging-meili-key

# ---------- 鉴权 ----------
JWT_ACCESS_SECRET=change-me-staging-jwt-secret

# ---------- 站点（需与 GitHub 变量 NUXT_PUBLIC_SITE_URL_STAGING 保持一致）----------
CORS_ORIGINS=http://<服务器IP>:8080
NUXT_PUBLIC_SITE_URL=http://<服务器IP>:8080

# ---------- 阿里云 OSS（必需，图片与视频都由浏览器直传这里 + CDN）----------
# OSS_PUBLIC_URL 填 CDN 加速域名（回源 bucket），库里存的就是它拼对象名得到的地址
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_URL=https://cdn.devshare.bond

# ---------- 图片（可选）----------
# 单个图片最大体积（MB），默认 20
MAX_IMAGE_SIZE_MB=20
# 读取图片时是否让 OSS 图片处理（IMG）转 WebP：默认 on；bucket 未开通图片处理时设 off 回退原图
NUXT_PUBLIC_OSS_IMAGE_WEBP=on

# ---------- 课程视频（可选）----------
MAX_VIDEO_SIZE_MB=4096
# STS 直传凭证用的角色 ARN（形如 acs:ram::1234567890:role/devshare-video）：
# 在 RAM 里建一个「可信实体为本账号 RAM 用户」的角色，并给它 OSS 读写权限；留空则图片与视频上传都不可用
OSS_STS_ROLE_ARN=
# STS 临时凭证有效期（秒）：默认 3600，下限 900，上限受角色的 MaxSessionDuration 约束
OSS_STS_DURATION_SECONDS=3600
