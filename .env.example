# ---------- Docker Compose（部署）----------
POSTGRES_USER=devshare
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=devshare

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
MEILI_MASTER_KEY=change-me-meili-master-key

CORS_ORIGINS=https://www.example.com
NUXT_PUBLIC_SITE_URL=https://www.example.com

# ---------- 阿里云 OSS（必需，图片与视频都由浏览器直传这里 + CDN）----------
# 未配置 OSS 或 OSS_STS_ROLE_ARN 时，图片与视频上传都会置灰（没有本地磁盘兜底）
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_URL=

# ---------- 图片（可选）----------
# 单个图片最大体积（MB），默认 20；图片直传 OSS，原图上传不做服务端转码，
# 展示时由 OSS 图片处理（IMG）按需输出 WebP
MAX_IMAGE_SIZE_MB=20
# 读取图片时是否让 OSS 图片处理（IMG）转 WebP：默认 on；bucket 未开通图片处理时设 off 回退原图
NUXT_PUBLIC_OSS_IMAGE_WEBP=on

# ---------- 课程视频（可选）----------
# 单个视频最大体积（MB），默认 4096（4GB）；视频直传 OSS，不受 nginx client_max_body_size 限制
MAX_VIDEO_SIZE_MB=4096
# STS 直传凭证用的角色 ARN（形如 acs:ram::1234567890:role/devshare-video）：
# 在 RAM 里建一个「可信实体为本账号 RAM 用户」的角色，并给它 OSS 读写权限；留空则课程视频上传不可用
OSS_STS_ROLE_ARN=
# STS 临时凭证有效期（秒）：默认 3600，下限 900，上限受角色的 MaxSessionDuration 约束
OSS_STS_DURATION_SECONDS=3600
