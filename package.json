{
  "name": "devshare",
  "version": "0.1.0",
  "private": true,
  "description": "DevShare（技享）- 开发者技术分享社区（monorepo）",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "postinstall": "pnpm --filter @devshare/shared build",
    "prepare": "husky",
    "dev": "concurrently -n web,api -c cyan,green \"pnpm --filter @devshare/web dev\" \"pnpm --filter @devshare/api start:dev\"",
    "dev:web": "pnpm --filter @devshare/web dev",
    "dev:api": "pnpm --filter @devshare/api start:dev",
    "build": "pnpm --filter @devshare/shared build && pnpm --filter @devshare/api build && pnpm --filter @devshare/web build",
    "build:web": "pnpm --filter @devshare/web build",
    "build:api": "pnpm --filter @devshare/api build",
    "test": "pnpm --filter @devshare/shared build && pnpm --filter @devshare/api test && pnpm --filter @devshare/web test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @devshare/api prisma:migrate",
    "db:seed": "pnpm --filter @devshare/api prisma:seed",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "lint:eslint": "eslint . --max-warnings=0",
    "preview:all": "concurrently -n api,web -c green,cyan \"pnpm --filter @devshare/api start:prod\" \"pnpm --filter @devshare/web preview\""
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.6.2",
    "eslint": "^9.0.0",
    "@nuxt/eslint": "^1.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "prettier --write",
      "node scripts/lint-staged-eslint.mjs"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "**/*": [
      "node scripts/lint-staged-check.mjs"
    ]
  }
}
