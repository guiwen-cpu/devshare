# 浏览器侧 API 走同源 /api（nginx 反代），无需改动
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# 服务端直连 API 的地址（可省略，省略时用 nuxt.config 里的默认值 127.0.0.1:3001/api/v1）
# Docker 部署时不需要配这里，compose 会注入 NUXT_API_BASE 覆盖
NUXT_API_BASE=http://127.0.0.1:3001/api/v1
# 读取 OSS 图片时是否让 OSS 图片处理（IMG）转 WebP：默认 on；bucket 未开通图片处理时设 off 回退原图
NUXT_PUBLIC_OSS_IMAGE_WEBP=on
