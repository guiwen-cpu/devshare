# ---------- 基础 ----------
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000

# ---------- 数据库 ----------
# 注意：密码需与仓库根目录 .env 的 POSTGRES_PASSWORD 保持一致
DATABASE_URL=postgresql://devshare:change-me-strong-password@localhost:5432/devshare?schema=public

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- JWT ----------
JWT_ACCESS_SECRET=devshare-access-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=604800

# ---------- Meilisearch ----------
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=change-me-meili-master-key

# ---------- 上传（图片与视频都由浏览器直传 OSS）----------
# 单个图片最大体积（MB），默认 20；原图直传，展示时由 OSS 图片处理按需转 WebP
MAX_IMAGE_SIZE_MB=20
# 课程视频体积上限（MB），默认 4096
MAX_VIDEO_SIZE_MB=4096

# ---------- 阿里云 OSS（必需，不配置则上传不可用）----------
# OSS_PUBLIC_URL 填 CDN 加速域名（回源 bucket），库里存的就是它拼对象名得到的地址
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_URL=https://cdn.devshare.bond

# ---------- STS 直传凭证（必需）----------
# 形如 acs:ram::1234567890:role/devshare-upload；留空则图片与视频上传都不可用
OSS_STS_ROLE_ARN=
# 临时凭证有效期（秒）：默认 3600，下限 900，上限受角色的 MaxSessionDuration 约束
OSS_STS_DURATION_SECONDS=3600
